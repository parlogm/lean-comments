{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" session-start",
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\bin\\lean-comments-windows-x86_64.exe\" session-start",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}\\bin\\lean-comments-windows-x86_64.exe\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|edit|create|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run\" post-tool-use",
            "commandWindows": "\"${CLAUDE_PLUGIN_ROOT}\\bin\\lean-comments-windows-x86_64.exe\" post-tool-use",
            "powershell": "& \"${CLAUDE_PLUGIN_ROOT}\\bin\\lean-comments-windows-x86_64.exe\" post-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
